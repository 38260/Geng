# ============================================================
#  赶梗潮 · 环境变量示例
#  复制为 backend/.env 后按需修改；backend/.env 已被 .gitignore 忽略
# ============================================================

# ---------------- LLM（LongCat，OpenAI 兼容接口） ----------------
LLM_PROVIDER=longcat

LLM_BASE_URL=https://api.longcat.chat/openai/v1

# 只需填这一行（以及可选的 LLM_MODEL）即可启用趋势解释 / 赶梗建议
LLM_API_KEY=

LLM_MODEL=LongCat-2.5-Preview
# 「这个梗是什么」的 AI 摘要单独用这个模型；留空 = 跟随 LLM_MODEL。
# 思考型模型（如 LongCat-2.5-Preview）会把预算烧在 reasoning 上、正文返回空，
# 这个任务在它上面必然失败，所以默认挑一个直出正文的模型。
LLM_INTRO_MODEL=LongCat-2.0

LLM_TEMPERATURE=0.3

LLM_MAX_TOKENS=300

# 单位：秒。最坏耗时 ≈ LLM_TIMEOUT × (LLM_MAX_RETRIES + 1) + 退避
LLM_TIMEOUT=10

# 429 / 超时时的有限指数退避次数（禁止无限重试）
LLM_MAX_RETRIES=2

# LLM 不可用时是否允许输出纯算法生成的短句（false 则前端显示"暂时无法生成赶梗建议"）
LLM_ALLOW_RULE_BASED_FALLBACK=true

# ---------------- 数据库 ----------------
# 默认本地 SQLite；装有 PostgreSQL 时改成下面这行即可，无需改代码
DATABASE_URL=sqlite:///./data/gengv1.db
# DATABASE_URL=postgresql+psycopg2://geng:geng@127.0.0.1:5432/gengchao

# ---------------- 数据源 ----------------
# mock = 演示数据（页面会明确标注）；bilibili = 真实采集
DATA_SOURCE=mock

# 真实采集时可选填网页 Cookie，用于绕过 B 站风控（留空则用匿名请求）
BILI_COOKIE=

BILI_SEARCH_URL=https://api.bilibili.com/x/web-interface/wbi/search/type

BILI_USER_SPACE_URL=https://api.bilibili.com/x/space/wbi/arc/search

BILI_TIMEOUT=10

# ---------------- 分析窗口 ----------------
ANALYSIS_WINDOW_DAYS=30
RELEVANCE_THRESHOLD=0.5

# ---------------- 发现层（梗库准入） ----------------
# 认证窗口：任一 UP 主（梗百科为主、梗指南补）在最近这么多天里真实介绍过就入池。
# 刻意比 ANALYSIS_WINDOW_DAYS 宽——解说视频通常比梗的爆发期早 1~2 周。
CERT_WINDOW_DAYS=90

# 热榜的"活着"门槛：过气（考古区）不上榜，且近 7 天头部播放须 ≥ BOARD_MIN_RECENT_VIEW。
# 关掉后过气梗会回到首页热榜（只在排查数据时用）；梗库 scope=all 始终不受影响。
LEADERBOARD_GATE=true

# 真实数据源下，榜单/详情只收"B 站真实采到 + 至少一位 UP 主有真实投稿证据"的梗；
# 关掉后手写演示梗会和真梗同榜混排（只建议在演示时用）
LEADERBOARD_REQUIRE_VERIFIED=true

# 热榜只看"最新准入池"：上榜资格 = 认证窗口（CERT_WINDOW_DAYS）内还有真实解说证据
# （meme_certifications 里 data_source=bilibili 且 published_at 在窗口内）。
# `encyclopedia_confirmed` 那种一次性布尔标记扛不住时间——解说视频会过期，
# 但标记永远为真，老梗就会靠存量热度一直赖在"今天玩什么"里。
# 只收紧热榜口径；scope=all 的完整梗库不受影响。演示模式（DATA_SOURCE=mock）下不生效。
LEADERBOARD_REQUIRE_FRESH_CERT=true

# 在线核验被风控挡住时，是否允许人工整理但未核验的梗参与分析
ANALYSIS_ALLOW_UNVERIFIED=true

# ---------------- 数据刷新 ----------------
# 每天几点自动跑一次增量刷新（HH:MM）。留空 = 只手动触发，
# 不默认往机器上塞后台任务。进程不常驻时请改用系统计划任务：
#   python -m app.scripts.daily_refresh --trigger 定时
REFRESH_AT=

# 每周哪天改跑一次全窗口重采（0=周一 … 6=周日，-1=不做周校准）。
# 老日子的头部播放量会随时间涨，只增量会让旧日子停在偏低值，靠这个校准回来。
REFRESH_FULL_WEEKDAY=0

# 启动时若"统计截至"已滞后超过一天，自动补跑一次增量。
# 00:00 那一刻笔记本多半在睡，不补就要等到第二天。只在 REFRESH_AT 非空时才生效。
REFRESH_ON_START=true

# 定时刷新要不要顺带翻两位 UP 主的投稿列表发现新梗。
# 这一步最容易被风控（投稿列表接口是重灾区），关掉就只刷已有梗的数据。
REFRESH_DISCOVERY=true

# ---------------- 采集节流与风控保险 ----------------
# 请求之间的最小间隔（秒）——这是**风控安全阀**，不是性能参数。
# 默认 1.2 秒 ≈ 0.8 次/秒，大致是"人手动连续搜索"的速率。
# 曾经写死 0.35 秒（2.9 次/秒）：全库重采约 3,300 次请求，那个速率下很快就被打进限流。
# 调慢只是多花几十分钟；调快可能直接触发风控。更保守可以设 2~5。
COLLECT_REQUEST_GAP=1.2

# 连续多少个梗撞上**硬风控**（412 / -352 / 需要 Cookie）就中止整个采集任务。
# 软限流只会被吞掉结果，硬风控是风控升级的信号——继续跑既拿不到数据又在喂风控。
# 设 0 = 关闭这个保险（退回"失败就跳过、继续下一个梗"）。
COLLECT_BLOCK_ABORT_AFTER=3

# ---------------- 采集抖动兜底 ----------------
# B 站搜索的"没有结果"分两种，必须分开对待：
#   真的没内容 : {"result": [], "numResults": 0, ...}   可信
#   被限流吞掉 : {"v_voucher": "voucher_xxx"}           没有 numResults 字段
# 后者是风控应答（HTTP 200、无错误码），搜「动画」这种绝对有内容的词也会被吞，
# 所以它不代表"当天没有内容"。它会随持续请求累积：冷启动命中率 ~98%，
# 连续打几百次后掉到 0~30%，且处罚窗口是**数小时级**。

# 首次之外的额外重试次数。设 0 = 退回旧行为（空壳当零活动）。
COLLECT_DAY_RETRIES=2

# 重试间隔基准（秒），乘上第几次递增。贴着打会让风控更紧。
COLLECT_RETRY_GAP=1.2

# 命中限流后整个会话停多久（秒）再继续。这是缓解手段，不是解药：
# 限流是**会话级**状态——换词、换日期、立刻重试都没用。
# 实测（2026-09-30）停 180 秒后仍然 3/3 被吞，处罚窗口是数小时级、不是分钟级。
# 所以这个冷却只能避免"硬打加深处罚"；要稳定拿到数据，根本手段是配 BILI_COOKIE。
COLLECT_THROTTLE_COOLDOWN=180

# 一次静默之后仍连续被吞这么多天，才放弃这条窗口。有 cooldown 兜底时不该触发。
COLLECT_THROTTLE_STOP_AFTER=8

# ---------------- 服务 ----------------
APP_ENVIRONMENT=Development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 写接口访问控制 ----------------
# 留空 = 不校验（默认；只适合本机或内网）。
# 公网部署**必须**设置，否则下面这些写接口任何人可调：
#   POST/PATCH /api/manage/memes   改封面 / 介绍 / 别名 / 关键词
#   POST       /api/jobs/*         触发全库重采（打 B 站接口）与重算
#   PUT        /api/settings/llm   改写 LLM 配置
#   POST       /api/llm/*          消耗 LLM 额度
#   POST       /api/memes/{id}/insight  同上看（会调 LLM）
# 启用后，写接口需带请求头：X-Admin-Token: <与下面一致的值>
# 只读接口（/api/health、/api/meta、GET /api/memes*）不受影响，
# 小程序端只走只读接口，因此开不开都能正常用。
# 生成一个足够随机的值：python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

