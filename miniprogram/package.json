{
  "name": "gengchao-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "赶梗潮微信小程序（Taro + React + TS，一份代码出 weapp / h5）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/format.test.ts tests/contract.test.ts"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.1.6",
    "@tarojs/helper": "4.1.6",
    "@tarojs/plugin-framework-react": "4.1.6",
    "@tarojs/plugin-platform-h5": "4.1.6",
    "@tarojs/plugin-platform-weapp": "4.1.6",
    "@tarojs/react": "4.1.6",
    "@tarojs/runtime": "4.1.6",
    "@tarojs/shared": "4.1.6",
    "@tarojs/taro": "4.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.1.6",
    "@tarojs/webpack5-runner": "4.1.6",
    "@types/react": "^18.3.3",
    "babel-preset-taro": "4.1.6",
    "react-refresh": "^0.14.2",
    "sass": "^1.77.0",
    "typescript": "^5.4.5"
  }
}
